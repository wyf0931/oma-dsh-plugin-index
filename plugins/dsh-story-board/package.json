{
  "name": "dsh-story-board",
  "version": "0.2.1",
  "private": true,
  "description": "User story boards for DeepSeek Harness: products, projects, boards, stories, and agent tools that create, import, and move them.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "story-board",
    "kanban",
    "agile",
    "user-story",
    "bundle"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "store.js",
    "prompt.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.png",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/store.test.mjs test/prompt.test.mjs test/host.test.mjs test/client.smoke.mjs",
    "check": "node --check index.js && node --check store.js && node --check prompt.js && node --check client.js && node --test test/store.test.mjs test/prompt.test.mjs test/host.test.mjs test/client.smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": "wyf0931",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyf0931/dsh-story-board.git"
  },
  "homepage": "https://github.com/wyf0931/dsh-story-board#readme",
  "bugs": {
    "url": "https://github.com/wyf0931/dsh-story-board/issues"
  }
}
