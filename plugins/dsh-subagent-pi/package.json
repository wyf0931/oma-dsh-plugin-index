{
  "name": "dsh-subagent-pi",
  "version": "0.3.0",
  "description": "Pi coding agent as a DeepSeek Harness subagent provider: one isolated `pi` process per delegation, with resumable sessions over Pi RPC.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "pi",
    "coding-agent",
    "subagent",
    "rpc"
  ],
  "license": "MIT",
  "author": "dsh-pi contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./tool/locale/*.json": "./tool/locale/*.json",
    "./tool/icon.svg": "./tool/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tool",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf lib *.tsbuildinfo"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1",
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
